# ============================================================================
# .env.example  —  copy values into Vercel → Settings → Environment Variables.
# DO NOT commit a filled-in version of this file. Secrets live in Vercel only.
# ============================================================================

# --- Supabase (already required by the base app) -----------------------------
NEXT_PUBLIC_SUPABASE_URL=https://ttebeawoxnruxlgbruza.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...                 # Supabase → Settings → API → anon/public
SUPABASE_SERVICE_ROLE_KEY=eyJ...                     # Supabase → Settings → API → service_role  (SECRET, server-only)
CRON_SECRET=any-long-random-string                   # protects the cron endpoints

# --- Google (Search Console, GA4, Tag Manager, Google Ads) -------------------
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web app)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google Ads only (data-pull phase): apply for a developer token in a Google Ads
# manager (MCC) account → API Center. login-customer-id is the MCC id, digits only.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Meta (Instagram + Facebook) ---------------------------------------------
# developers.facebook.com → your app → Settings → Basic
META_APP_ID=
META_APP_SECRET=

# --- LinkedIn Pages ----------------------------------------------------------
# linkedin.com/developers → your app → Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Ahrefs / Semrush (optional, API-key sources) ----------------------------
AHREFS_API_KEY=
